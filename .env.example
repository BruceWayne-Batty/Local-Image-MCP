# 推荐运行 npm run setup 创建用户配置文件。
# 以下环境变量均为可选覆盖项，优先级高于配置文件。
# NEW API 服务地址可以写站点根地址，也可以带 /v1 或 /v1beta。
NEW_API_BASE_URL=https://your-new-api.example.com
NEW_API_KEY=sk-your-key

# 可选：默认协议和模型，也可以在每次工具调用时覆盖。
IMAGE_PROTOCOL=openai
OPENAI_IMAGE_MODEL=gpt-image-1.5
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 可选：图片保存目录。默认是当前目录下的 output。
IMAGE_OUTPUT_DIR=./output

# 可选：请求超时（毫秒）。
IMAGE_REQUEST_TIMEOUT_MS=120000
